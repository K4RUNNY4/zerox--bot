# Discord Bot Configuration
# Get your bot token and client ID from https://discord.com/developers/applications

# 1. Your Discord Bot Token (Bot -> Reset Token)
DISCORD_TOKEN=YOUR_BOT_TOKEN_HERE

# 2. Your Bot Application/Client ID (General Information -> Application ID)
CLIENT_ID=YOUR_APPLICATION_ID_HERE

# 3. (Optional) Your Server/Guild ID for instant slash command registration during development
# Enable Developer Mode in Discord (User Settings -> Advanced -> Developer Mode), then right click your server icon and click "Copy Server ID"
GUILD_ID=
